# ============================================
# Nekowise — Docker Compose Environment
# ============================================
# Copy this file to .env.docker and update values.
# Used by: docker compose up
# ============================================

# ── Server ────────────────────────────────────
NODE_ENV=production
PORT=5000

# MongoDB (uses Docker service name as host)
MONGODB_URI=mongodb://mongo:27017/nekowise

# JWT — CHANGE THESE for any non-local usage
JWT_SECRET=docker-dev-secret-change-me-32chars-minimum!!
JWT_REFRESH_SECRET=docker-dev-refresh-secret-change-me-32chars!!
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# CORS — matches the client container URL
CLIENT_URL=http://localhost

# Logging
LOG_LEVEL=info
